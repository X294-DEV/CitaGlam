# --- Entorno de Aplicación ---
PORT=3001
NODE_ENV=development
JWT_SECRET=CAMBIAR_ESTE_VALOR_genera_uno_con_openssl_rand_base64_48
JWT_EXPIRES_IN=1h

# Contraseña inicial del superadmin (admin@cgbg.com) que crea el seed
SEED_ADMIN_PASSWORD=CAMBIAR_ESTE_VALOR

# --- Base de Datos PostgreSQL (Docker Internal) ---
POSTGRES_USER=postgres
# Solo letras y números: va dentro de DATABASE_URL y un @ o : la rompe
POSTGRES_PASSWORD=CAMBIAR_ESTE_VALOR
POSTGRES_DB=cgbg_bd
# Conexión para el Backend (Dentro de Docker):
DATABASE_URL="postgresql://postgres:CAMBIAR_ESTE_VALOR@cgbg-postgres:5432/cgbg_bd?schema=public"

# --- Caché Redis (Docker Internal) ---
REDIS_URL="redis://cgbg-redis:6379"

# --- Mensajería RabbitMQ (Docker Internal) ---
RMQ_URL="amqp://guest:guest@cgbg-rabbitmq:5672"

# --- URLs locales ---
# FRONTEND_URL (panel) y WEB_URL (sitio público) son los únicos orígenes que
# acepta CORS. Para varios orígenes, sepáralos con comas.
API_INTERNAL_URL="http://cgbg-backend:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:4200"
